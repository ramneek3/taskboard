aws_region      = "ap-south-1"
environment     = "dev"
cluster_name    = "taskboard-eks"
cluster_version = "1.35"

# 3 x t3.medium is enough for the app, Argo CD, and kube-prometheus-stack.
node_instance_types = ["t3.medium"]
node_min_size       = 2
node_max_size       = 4
node_desired_size   = 3

# Leave empty to avoid CloudWatch log charges.
cluster_enabled_log_types = []
vpc_cidr                  = "10.20.0.0/16"

# Copy to .env for Docker Compose. Replace every placeholder before use.
# Do not commit the copied .env file.

POSTGRES_USER=taskboard
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=taskboard
POSTGRES_PORT=5432

# Host port for the API and the Vite dev proxy. Compose publishes this.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Used by `docker compose -f docker-compose.yml -f docker-compose.observability.yml`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Host-run backend (outside Compose) talks to Postgres on localhost.
# DATABASE_URL=postgresql+psycopg://taskboard:replace-with-a-long-random-password@localhost:5432/taskboard
